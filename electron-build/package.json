{
  "name": "browserctrl",
  "productName": "BrowserCtrl",
  "version": "1.0.0",
  "description": "BrowserCtrl Desktop App",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "dev.browserctrl.app",
    "productName": "BrowserCtrl",
    "files": [
      "electron.js",
      "preload.js",
      "browser-manager.js",
      "node_modules/**/*",
      "../dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "dmg": {
      "title": "BrowserCtrl",
      "backgroundColor": "#0d1117"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "ia32"] }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["en_US", "ru_RU"],
      "language": "1049"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "puppeteer-core": "^21.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}